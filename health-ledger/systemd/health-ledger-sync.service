[Unit]
Description=Sync private health ledger
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=xunji-agent
Group=xunji-agent
WorkingDirectory=/home/xunji-agent/health-ledger
ExecStart=/usr/bin/python3 -B ledger.py sync --include-today-zepp --include-today-xunji
UMask=0077
TimeoutStartSec=15min
NoNewPrivileges=true
