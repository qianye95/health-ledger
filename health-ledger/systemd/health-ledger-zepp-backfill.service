[Unit]
Description=Backfill Zepp health history
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=xunji-agent
Group=xunji-agent
WorkingDirectory=/home/xunji-agent/health-ledger
ExecStart=/usr/bin/python3 -B ledger.py backfill-zepp --since 2024-10-01
ExecStart=/usr/bin/python3 -B ledger.py backfill-zepp --since 2023-10-01 --end 2024-09-30
UMask=0077
TimeoutStartSec=1h
NoNewPrivileges=true
