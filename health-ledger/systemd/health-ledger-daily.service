[Unit]
Description=Generate and deliver the private daily health summary
Wants=network-online.target xunji-openclaw.service
After=network-online.target xunji-openclaw.service health-ledger-sync.service
Before=health-ledger-weekly.service

[Service]
EnvironmentFile=-/etc/health-ledger/dashboard.env
Type=oneshot
User=xunji-agent
Group=xunji-agent
WorkingDirectory=/home/xunji-agent/health-ledger
Environment=PATH=/home/xunji-agent/.openclaw/bin:/home/xunji-agent/.openclaw/tools/node/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -B ledger.py daily-report
ExecStart=/usr/bin/python3 -B ledger.py send-saved-report daily
UMask=0077
TimeoutStartSec=10min
NoNewPrivileges=true
